# Never commit credentials or real knowledge libraries.
.env
.env.*
!.env.example
*credentials*.json
*.pem
*.key
tokens/
secrets/
Vault/
vault/
real-vault/
storage/
# P0 checkout is fetched separately; it is not a Git submodule or app delivery.
/upstream/
node_modules/
__pycache__/
*.pyc
.venv/
.DS_Store
playwright-report/
test-results/
target/
/dist/

# Isolated prototype runtime; never commit user notes or local session data.
/.local/

# Android generated runtimes, build outputs and local signing material.
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/app/src/main/assets/*.zip
/android/app/src/main/assets/payload.json
*.jks
*.keystore
