{
  "name": "@corilo/dsh-notes",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./index.mjs",
    "./store": "./storage.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "storage.mjs",
    "api.mjs",
    "lib/client.js",
    "README.md",
    "notes.patch.example.yml",
    "cli.mjs",
    "history.mjs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "recovery-tools.mjs",
    "library.mjs",
    "QUICKSTART.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test:browser": "python3 test/browser_capabilities.py && python3 test/browser.py && python3 test/drafts_browser.py && python3 test/draft_stash_browser.py && python3 test/recovery_browser.py && python3 test/library_browser.py",
    "test:distribution": "node --test test/distribution.test.mjs",
    "benchmark": "node test/benchmark.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@vscode/ripgrep": "1.18.0",
    "idb": "8.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "esbuild": "0.25.12",
    "uuid": "11.1.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "bin": {
    "corilo-notes": "./cli.mjs"
  }
}
