{
  "name": "@corilo/dsh-notes",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./index.mjs",
    "./store": "./storage.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "storage.mjs",
    "api.mjs",
    "lib/client.js",
    "README.md",
    "notes.patch.example.yml",
    "cli.mjs",
    "history.mjs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "recovery-tools.mjs",
    "library.mjs",
    "QUICKSTART.zh-CN.md",
    "restore.mjs",
    "BACKUP.zh-CN.md",
    "LINUX.zh-CN.md",
    "corilo-notes.service.example",
    "workspace-store.mjs",
    "workspace-api.mjs",
    "workspace/",
    "vendor/filesmd/",
    "import-todos.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test:browser": "python3 test/workspace_browser.py && python3 test/core_browser.py",
    "test:distribution": "node --test test/distribution.test.mjs",
    "benchmark": "node test/benchmark.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@lezer/highlight": "1.2.5",
    "@vscode/ripgrep": "1.18.0",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "esbuild": "0.25.12",
    "uuid": "11.1.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "bin": {
    "corilo-notes": "./cli.mjs",
    "corilo-import-todos": "./import-todos.mjs"
  }
}
